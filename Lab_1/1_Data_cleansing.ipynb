   "source": [
    "Сохраним подготовленный датафрейм в Apache Iceberg. Создадим базу данных в каталоге Spark."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "41838ec6eb2d2d9d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Передаём SQL-команду Spark: создаём базу, если её ещё нет; существующая база сохраняется.\n",
    "spark.sql(f\"CREATE DATABASE IF NOT EXISTS spark_catalog.{database_name}\")\n",
    "# Выбираем базу текущей: короткие имена таблиц будут искаться в ней.\n",
    "spark.catalog.setCurrentDatabase(database_name)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "75bca5c26fa3614e",
   "metadata": {},
   "source": [
    "Запишем таблицу"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f644089b1d104872",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "26/10/29 02:18:18 WARN SparkStringUtils: Truncated the string representation of a plan since it was too large. This behavior can be adjusted by setting 'spark.sql.debug.maxToStringFields'.\n",
      "                                                                                \r"
     ]
    }
   ],
   "source": [
    "# writeTo() указывает, в какую таблицу записать df; using() задаёт формат Iceberg.\n",
    "# createOrReplace() создаёт таблицу или заменяет существующую\n",
    "df.writeTo(full_table_name).using(\"iceberg\").createOrReplace()"
   ]
  },
