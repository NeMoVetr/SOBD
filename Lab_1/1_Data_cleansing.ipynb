   "source": [
    "# Для каждого столбца отбираем строки с пропусками и считаем их.\n",
    "missing_counts = {}\n",
    "columns_with_missing = 0\n",
    "total_missing = 0\n",
    "\n",
    "for column in df.columns:\n",
    "    missing_rows = df.filter(F.col(column).isNull())\n",
    "    missing_count = missing_rows.count()\n",
    "    missing_counts[column] = missing_count\n",
    "\n",
    "    if missing_count > 0:\n",
    "        print(f\"{column}: {missing_count}\")\n",
    "        columns_with_missing = columns_with_missing + 1\n",
    "\n",
    "    # Суммируем число пустых ячеек во всех столбцах.\n",
    "    total_missing = total_missing + missing_count\n",
    "\n",
    "print(f\"Столбцов с пропусками: {columns_with_missing}\")\n",
    "print(f\"Всего пропусков: {total_missing}\")"
   ]
  },
