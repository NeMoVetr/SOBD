    "# Проверяем NaN в каждом числовом столбце отдельно.\n",
    "numeric_columns = num_cols + [target_col]\n",
    "numeric_problem_cols = []\n",
    "\n",
    "for column in numeric_columns:\n",
    "    # Отбираем строки с NaN и считаем их.\n",
    "    nan_rows = df.filter(F.isnan(F.col(column)))\n",
    "    nan_count = nan_rows.count()\n",
    "\n",
    "    if nan_count > 0:\n",
    "        numeric_problem_cols.append(column)\n",
    "        print(f\"{column}: NaN — {nan_count}\")\n",
    "\n",
    "print(f\"Числовых столбцов с NaN: {len(numeric_problem_cols)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "516bce9a075712d0",
   "metadata": {},
   "source": [
    "### Решение по результатам проверки\n",
    "\n",
    "В полном запуске обнаружены **NaN в 61 числовом столбце**. Положительные и отрицательные бесконечности не найдены. Недопустимых значений в бинарных признаках тоже нет.\n",
    "\n",
    "| Что наблюдаем | Решение |\n",
    "|---|---|\n",
    "| `num_*` и `cooking_time_minutes` уже имеют тип float | Сохраняем тип. |\n",
    "| `bin_*` содержат только 0 и 1 | Сохраняем значения и исходный тип. |\n",
    "| `cat_*` уже имеют тип bigint | Оставляем коды категорий без изменения. |\n",
    "| `timestamp` уже имеет тип timestamp_ntz | Сохраняем тип и записанное время. |\n",
    "| В 61 числовом столбце есть NaN | Заменяем NaN на NULL в этих столбцах. |\n",
    "\n",
    "\n",
    "`NaN` означает «не число». Замена на NULL позволяет явно учитывать такие значения как пропуски при дальнейшей очистке. Бесконечности не обнаружены при ранее выполненной полной проверке этого файла. Их повторный подсчёт и обработка удалены.\n",
    "\n",
    "Количество строк, названия столбцов и их типы сохраняются. Вторая часть занимается заполнением пропусков и обработкой длительностей."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "813d6c99713d2ec8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Функция получает таблицу и возвращает таблицу после необходимых изменений.\n",
    "def transform_dataframe(data: DataFrame) -> DataFrame:\n",
    "    result = data\n",
    "\n",
    "    # По результатам диагностики проблема этих столбцов — значения NaN.\n",
    "    for column in numeric_problem_cols:\n",
    "        # withColumn() заменяет столбец с тем же названием.\n",
    "        # when() задаёт «если», otherwise() — «иначе».\n",
    "        result = result.withColumn(\n",
    "            column,\n",
    "            F.when(F.isnan(F.col(column)), F.lit(None))\n",
    "             .otherwise(F.col(column))\n",
    "        )\n",
    "\n",
    "    # Бинарные столбцы меняем только при наличии недопустимых значений.\n",
    "    for column in binary_problem_cols:\n",
    "        # Если значение равно 0 — оставляем его.\n",
    "        # Если равно 1 — тоже оставляем; иначе записываем пропуск.\n",
    "        result = result.withColumn(\n",
    "            column,\n",
    "            F.when(F.col(column) == 0, F.col(column))\n",
    "             .when(F.col(column) == 1, F.col(column))\n",
    "             .otherwise(F.lit(None))\n",
    "        )\n",
    "\n",
    "    return result"
   ]
  },
